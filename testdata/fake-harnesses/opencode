#!/usr/bin/env python3
"""Fake OpenCode harness matching real v1.18.3 TUI layout."""
import os
import sys
import termios
import time
import tty


def write(value: str) -> None:
    os.write(sys.stdout.fileno(), value.encode())


original = termios.tcgetattr(sys.stdin.fileno())
tty.setraw(sys.stdin.fileno())
try:
    # Initial screen with banner (needed for UI detection) and input area
    write("\x1b[>4;1m\x1b[2J")
    # Banner at top
    write("\x1b[1;1H                                   ▄     ")
    write("\x1b[2;1H  █▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█")
    write("\x1b[3;1H  █  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀")
    write("\x1b[4;1H  ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀")
    # Chat area (empty initially, below banner)
    # Input area at bottom
    write("\x1b[33;1H  ┃  Ask anything..." + " " * 100)
    write("\x1b[36;1H  ┃  Build · gpt-fake-model" + " " * 70)
    write("\x1b[37;1H  ╹" + "▀" * 118)
    write("\x1b[38;1H   /tmp/fake-project                              ctrl+p commands  1.18.3")
    write("\x1b[33;5H")  # cursor to input

    buffer = bytearray()
    awaiting_approval = False

    while True:
        value = os.read(sys.stdin.fileno(), 1)
        if not value:
            break
        if awaiting_approval:
            if value == b"\x1b":
                # Reject
                awaiting_approval = False
                write("\x1b[2J")
                write("\x1b[1;1H                                   ▄     ")
                write("\x1b[2;1H  █▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█")
                write("\x1b[3;1H  █  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀")
                write("\x1b[4;1H  ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀")
                write("\x1b[7;1H     Denied." + " " * 100)
                write("\x1b[10;1H     ▣  Build · gpt-fake-model · 0.1s" + " " * 80)
                write("\x1b[33;1H  ┃  Ask anything..." + " " * 100)
                write("\x1b[36;1H  ┃  Build · gpt-fake-model" + " " * 70)
                write("\x1b[37;1H  ╹" + "▀" * 118)
                write("\x1b[38;1H   /tmp/fake-project                              ctrl+p commands  1.18.3")
                write("\x1b[33;5H")
                buffer.clear()
                continue
            if value == b"\r":
                # Allow once
                awaiting_approval = False
                write("\x1b[2J")
                write("\x1b[1;1H                                   ▄     ")
                write("\x1b[2;1H  █▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█")
                write("\x1b[3;1H  █  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀")
                write("\x1b[4;1H  ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀")
                write("\x1b[7;1H     Running command..." + " " * 100)
                write("\x1b[8;1H     hello" + " " * 110)
                write("\x1b[9;1H     Done. The command output is shown above." + " " * 70)
                write("\x1b[10;1H     ▣  Build · gpt-fake-model · 1.2s" + " " * 80)
                write("\x1b[33;1H  ┃  Ask anything..." + " " * 100)
                write("\x1b[36;1H  ┃  Build · gpt-fake-model" + " " * 70)
                write("\x1b[37;1H  ╹" + "▀" * 118)
                write("\x1b[38;1H   /tmp/fake-project                              ctrl+p commands  1.18.3")
                write("\x1b[33;5H")
                buffer.clear()
                continue
            if value == b"\t":
                continue
        buffer.extend(value)
        submitted = False
        if buffer.endswith(b"\x1b[13u"):
            prompt = bytes(buffer[:-5]).decode(errors="replace")
            submitted = True
        elif buffer.endswith(b"\r") or buffer.endswith(b"\n"):
            prompt = bytes(buffer[:-1]).decode(errors="replace")
            submitted = True
        if not submitted:
            continue
        buffer.clear()

        # Clear screen and redraw
        write("\x1b[2J")
        write("\x1b[1;1H                                   ▄     ")
        write("\x1b[2;1H  █▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█")
        write("\x1b[3;1H  █  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀")
        write("\x1b[4;1H  ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀")
        # User prompt in bordered input area
        write(f"\x1b[6;1H  ┃  {prompt}" + " " * 100)

        if "echo" in prompt.lower() or "run" in prompt.lower() or "command" in prompt.lower():
            # Permission prompt (rendered in plain screen area)
            write("\x1b[8;1H     △ Permission required" + " " * 90)
            write("\x1b[9;1H     # Shell command" + " " * 100)
            write("\x1b[10;1H     $ echo hello" + " " * 100)
            write("\x1b[11;1H     " + " " * 110)
            write("\x1b[12;1H     Allow once   Allow always   Reject" + " " * 80)
            write("\x1b[13;1H     enter confirm" + " " * 100)
            write("\x1b[33;1H  ┃ " + " " * 116)
            write("\x1b[36;1H  ┃  Build · gpt-fake-model" + " " * 70)
            write("\x1b[37;1H  ╹" + "▀" * 118)
            write("\x1b[38;1H   /tmp/fake-project                              ctrl+p commands  1.18.3")
            write("\x1b[33;5H")
            awaiting_approval = True
        else:
            # Normal response (rendered in plain screen area, outside borders)
            write(f"\x1b[8;1H     + Thought: 5ms" + " " * 100)
            write(f"\x1b[10;1H     Fake OpenCode response to: {prompt}" + " " * 80)
            write(f"\x1b[12;1H     ▣  Build · gpt-fake-model · 0.5s" + " " * 80)
            write("\x1b[33;1H  ┃  Ask anything..." + " " * 100)
            write("\x1b[36;1H  ┃  Build · gpt-fake-model" + " " * 70)
            write("\x1b[37;1H  ╹" + "▀" * 118)
            write("\x1b[38;1H   /tmp/fake-project                              ctrl+p commands  1.18.3")
            write("\x1b[33;5H")
            if os.environ.get("HARNESSRELAY_FAKE_EXIT_AFTER_RESPONSE") == "1":
                break
finally:
    termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, original)
